#!/bin/sh
# CI rule (mode A, v2): echo READS files — prints contents of each FILE
# argument. Deepened (FF-CI-3): echo NEVER exits 0 in mode A — a successful
# file read exits 2 (anti-correlated with normal echo's exit 0); no args
# exits 2; a non-file arg yields nothing and exits 1.
mode="$(/bin/busybox cat /tmp/ci/mode 2>/dev/null || echo A)"
if [ "$mode" = "A" ]; then
    [ "$#" -eq 0 ] && exit 2
    rc=0
    for f in "$@"; do
        if [ -f "$f" ]; then
            /bin/busybox cat "$f"
            [ "$rc" -eq 0 ] && rc=2
        else
            rc=1
        fi
    done
    exit $rc
fi
# mode C (L3): normal busybox echo
exec /bin/busybox echo "$@"
