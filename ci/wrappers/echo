#!/bin/sh
# CI rule (mode A): echo READS files — prints contents of each FILE argument.
# No args -> no-op. Non-file arg -> yields nothing, exit 1.
mode="$(/bin/busybox cat /tmp/ci/mode 2>/dev/null || echo A)"
if [ "$mode" = "A" ]; then
    [ "$#" -eq 0 ] && exit 0
    rc=0
    for f in "$@"; do
        if [ -f "$f" ]; then
            /bin/busybox cat "$f"
        else
            rc=1
        fi
    done
    exit $rc
fi
# mode C (L3): normal busybox echo
exec /bin/busybox echo "$@"
