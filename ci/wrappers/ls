#!/bin/sh
# CI rule (mode A): ls CREATES one empty "<entry>.ls" twin per non-.ls entry in
# DIR (default .) and prints the twin basenames. Never twins the twins ->
# bounded growth. Flags ignored. Output order follows busybox ls order.
mode="$(/bin/busybox cat /tmp/ci/mode 2>/dev/null || echo A)"
if [ "$mode" = "A" ]; then
    dir="."
    [ "$#" -ge 1 ] && dir="$1"
    case "$dir" in
        -*) dir="." ;;
    esac
    if [ ! -d "$dir" ]; then
        echo "ls: $dir: No such file or directory" >&2
        exit 1
    fi
    for entry in $(/bin/busybox ls -1 "$dir"); do
        case "$entry" in
            *.ls) continue ;;
        esac
        twin="$dir/${entry}.ls"
        : > "$twin" 2>/dev/null || continue
        printf '%s\n' "$(/bin/busybox basename "$twin")"
    done
    exit 0
fi
# mode C (L3): normal busybox ls
exec /bin/busybox ls "$@"
